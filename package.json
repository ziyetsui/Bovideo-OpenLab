{
  "name": "apps-bo-pseo-platform-runtime",
  "version": "1.0.0",
  "description": "A blank template to get started with Payload 3.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "bootstrap:preview:admin": "tsx scripts/bootstrap-preview-admin.ts",
    "build": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" next build --webpack",
    "deploy": "tsx scripts/reject-legacy-d1-deploy.ts",
    "deploy:preview": "tsx scripts/reject-legacy-d1-deploy.ts",
    "deploy:preview:account": "tsx scripts/reject-legacy-d1-deploy.ts",
    "deploy:preview:app": "tsx scripts/reject-legacy-d1-deploy.ts",
    "deploy:preview:check": "tsx scripts/reject-legacy-d1-deploy.ts",
    "deploy:preview:database": "tsx scripts/reject-legacy-d1-deploy.ts",
    "deploy:preview:provision": "tsx scripts/reject-legacy-d1-deploy.ts",
    "deploy:preview:prepare": "tsx scripts/reject-legacy-d1-deploy.ts",
    "deploy:preview:secret": "tsx scripts/reject-legacy-d1-deploy.ts",
    "deploy:pvb:pages": "tsx static-preview/src/pages-deploy.ts",
    "deploy:pvb:pages:withdrawn": "tsx static-preview/src/pages-deploy.ts --mode withdrawn",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "dev:local": "cross-env NODE_OPTIONS=--no-deprecation tsx scripts/run-with-postgres.ts node_modules/next/dist/bin/next dev --hostname 127.0.0.1",
    "dev:persistent": "cross-env PSEO_FRONTEND_PREVIEW=0 NODE_OPTIONS=--no-deprecation tsx scripts/run-persistent-postgres.ts --migrate -- node_modules/next/dist/bin/next dev --hostname 127.0.0.1",
    "devsafe": "rm -rf .next && rm -rf .open-next && cross-env NODE_OPTIONS=--no-deprecation next dev",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "pnpm run generate:types:cloudflare && pnpm run generate:types:payload",
    "generate:types:cloudflare": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "generate:types:payload": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "ii": "pnpm install --ignore-workspace",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation eslint .",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "payload:migrate": "cross-env NODE_OPTIONS=--no-deprecation tsx scripts/managed-payload-migrate.ts",
    "payload:import": "cross-env NODE_OPTIONS=--no-deprecation tsx scripts/import-higgsfield-snapshot.ts",
    "payload:local:import": "cross-env NODE_OPTIONS=--no-deprecation tsx scripts/run-persistent-postgres.ts --migrate -- scripts/import-higgsfield-snapshot.ts",
    "payload:import:assets": "cross-env NODE_OPTIONS=--no-deprecation tsx scripts/import-assets-root.ts",
    "payload:local:import:assets": "cross-env NODE_OPTIONS=--no-deprecation tsx scripts/run-persistent-postgres.ts --migrate -- scripts/import-assets-root.ts",
    "payload:managed:import:assets": "cross-env NODE_OPTIONS=--no-deprecation tsx scripts/managed-payload-import-assets-root.ts",
    "payload:collect:twitter241": "cross-env NODE_OPTIONS=--no-deprecation tsx scripts/collect-and-import-twitter241.ts",
    "payload:local:collect:twitter241": "cross-env NODE_OPTIONS=--no-deprecation tsx scripts/run-persistent-postgres.ts --migrate -- scripts/collect-and-import-twitter241.ts",
    "payload:managed:collect:twitter241": "cross-env NODE_OPTIONS=--no-deprecation tsx scripts/managed-payload-collect-twitter241.ts",
    "payload:local:run": "cross-env NODE_OPTIONS=--no-deprecation tsx scripts/run-persistent-postgres.ts --migrate --",
    "payload:local:publish:projections": "cross-env NODE_OPTIONS=--no-deprecation tsx scripts/run-persistent-postgres.ts --migrate -- scripts/generate-local-pseo-projections.ts",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview --env=$CLOUDFLARE_ENV",
    "preview:static:build": "tsx static-preview/src/verify.ts build --out-dir static-preview/dist --git-sha $(git rev-parse HEAD)",
    "preview:static:build:withdrawn": "tsx static-preview/src/verify.ts build --out-dir static-preview/dist --git-sha $(git rev-parse HEAD) --mode withdrawn",
    "preview:static:serve": "tsx static-preview/src/static-server.ts --root static-preview/dist --host 127.0.0.1 --port 4173",
    "preview:static:verify": "tsx static-preview/src/verify.ts verify --out-dir static-preview/dist --git-sha $(git rev-parse HEAD)",
    "preview:static:verify:withdrawn": "tsx static-preview/src/verify.ts verify --out-dir static-preview/dist --git-sha $(git rev-parse HEAD) --mode withdrawn",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "test": "pnpm run test:int && pnpm run test:e2e",
    "test:e2e": "cross-env NODE_OPTIONS=\"--no-deprecation --import=tsx/esm\" playwright test --config=playwright.config.ts",
    "test:local-runtime": "cross-env NODE_OPTIONS=\"--no-deprecation --import=tsx/esm\" playwright test --config=playwright.local-runtime.config.ts",
    "test:e2e:preview": "cross-env NODE_OPTIONS=\"--no-deprecation --import=tsx/esm\" playwright test tests/e2e/preview-admin-flow.e2e.spec.ts --config=playwright.config.ts",
    "test:pvb:cms-local": "cross-env PREVIEW_BASE_URL= tsx scripts/run-with-postgres.ts node_modules/@playwright/test/cli.js test tests/e2e/local-admin-flow.e2e.spec.ts --config=playwright.config.ts",
    "test:pvb:browser": "cross-env PVB_STATIC_PREVIEW=1 NODE_OPTIONS=--no-deprecation playwright test tests/e2e/static-preview.e2e.spec.ts --config=playwright.config.ts",
    "test:preview:all": "pnpm run test:preview:static",
    "test:preview:static": "vitest run --config static-preview/vitest.config.mts",
    "test:phase1:access": "vitest run --config ./vitest.phase1.access.config.mts",
    "test:phase1:access:payload": "tsx scripts/run-with-postgres.ts node_modules/vitest/vitest.mjs run --config ./vitest.phase1.access-payload.config.mts",
    "test:phase1:access:payload:p1v": "tsx scripts/run-p1v-postgres.ts",
    "test:phase1:contracts": "vitest run --config ./vitest.phase1.config.mts tests/phase1/contracts",
    "test:phase1:storage": "vitest run --config ./vitest.phase1.config.mts tests/phase1/storage",
    "test:phase1:source": "vitest run --config ./vitest.phase1.config.mts tests/phase1/source-adapters",
    "test:phase1:observability": "vitest run --config ./vitest.phase1.config.mts tests/phase1/observability",
    "test:phase1:integration": "pnpm run test:int",
    "test:phase1:localization": "vitest run --config ./vitest.phase1.config.mts tests/phase1/localization",
    "test:phase1:queues": "vitest run --config ./vitest.phase1.config.mts tests/phase1/queues",
    "test:phase1:acceptance": "vitest run --config ./vitest.phase1.config.mts tests/phase1/acceptance",
    "test:phase2:p00": "vitest run --config ./vitest.phase2.config.mts tests/phase2/acceptance/preflight.spec.ts",
    "test:phase2:t01": "vitest run --config ./vitest.phase2.config.mts tests/phase2/orchestration/ingest-to-artifact.int.spec.ts",
    "test:phase2:t02": "vitest run --config ./vitest.phase2.config.mts tests/phase2/graph/elevation.contract.spec.ts tests/phase2/graph/review.int.spec.ts",
    "test:phase2:t03": "vitest run --config ./vitest.phase2.config.mts tests/phase2/localization/batch-review.int.spec.ts && playwright test --config ./playwright.phase2.config.ts tests/phase2/localization/review-ui.e2e.spec.ts",
    "test:phase2:t04": "vitest run --config ./vitest.phase2.config.mts tests/phase2/detail/schema.contract.spec.ts tests/phase2/detail/render.int.spec.ts && playwright test --config ./playwright.phase2.config.ts tests/phase2/detail/detail.e2e.spec.ts",
    "test:phase2:t05": "vitest run --config ./vitest.phase2.config.mts tests/phase2/publication/manifest.contract.spec.ts tests/phase2/publication/sitemap.contract.spec.ts tests/phase2/publication/export-fixture.security.spec.ts",
    "test:phase2:t06": "cross-env P2L_PORTS=4311,4312,4313 P2L_CACHE_ROOT=output/p2-local-cache vitest run --config ./vitest.phase2.config.mts tests/phase2/publication/activation.fault.spec.ts tests/phase2/publication/rollback.int.spec.ts tests/phase2/publication/withdrawal.int.spec.ts tests/phase2/publication/cache-convergence.int.spec.ts tests/phase2/publication/logical-smoke.int.spec.ts",
    "test:phase2:t07": "vitest run --config ./vitest.phase2.config.mts tests/phase2/acceptance/package.spec.ts tests/phase2/acceptance/scope.spec.ts",
    "test:phase2": "pnpm run test:phase2:t01 && pnpm run test:phase2:t02 && pnpm run test:phase2:t03 && pnpm run test:phase2:t04 && pnpm run test:phase2:t05 && pnpm run test:phase2:t06 && pnpm run test:phase2:t07",
    "test:phase3:t01": "vitest run --config ./vitest.phase3.config.mts tests/phase3/page/schema.contract.spec.ts tests/phase3/ui/tokens.contract.spec.ts",
    "test:phase3:t02": "vitest run --config ./vitest.phase3.config.mts tests/phase3/page/shell.contract.spec.tsx",
    "test:phase3:t03": "vitest run --config ./vitest.phase3.config.mts tests/phase3/page/projections.contract.spec.ts tests/phase3/ui/hub.contract.spec.tsx",
    "test:phase3:t04": "vitest run --config ./vitest.phase3.config.mts tests/phase3/page/projections.contract.spec.ts tests/phase3/ui/gallery.contract.spec.tsx",
    "test:phase3:t05": "vitest run --config ./vitest.phase3.config.mts tests/phase3/page/projections.contract.spec.ts tests/phase3/ui/entity.contract.spec.tsx",
    "test:phase3:t06": "vitest run --config ./vitest.phase3.config.mts tests/phase3/detail/production.contract.spec.tsx",
    "test:phase3:t07": "vitest run --config ./vitest.phase3.config.mts tests/phase3/page/modules.contract.spec.ts",
    "test:phase3:t08": "vitest run --config ./vitest.phase3.config.mts tests/phase3/page/structured-data.contract.spec.ts",
    "test:phase3:frontend": "cross-env NODE_OPTIONS=--no-deprecation playwright test --config ./playwright.phase3.config.ts",
    "test:phase3:frontend:visual": "cross-env PSEO_FRONTEND_VISUAL=1 NODE_OPTIONS=--no-deprecation playwright test --config ./playwright.phase3.config.ts tests/phase3/frontend/screenshots.e2e.spec.ts",
    "test:phase3:t09": "vitest run --config ./vitest.phase3.config.mts tests/phase3/page/quality.contract.spec.tsx tests/phase3/frontend/preview-adapter.spec.ts && pnpm run test:phase3:frontend",
    "test:phase3:t10": "vitest run --config ./vitest.phase3.config.mts tests/phase3/page/soak.contract.spec.ts tests/phase3/runtime/local-shutdown.int.spec.ts",
    "test:phase3": "pnpm run test:phase3:t01 && pnpm run test:phase3:t02 && pnpm run test:phase3:t03 && pnpm run test:phase3:t04 && pnpm run test:phase3:t05 && pnpm run test:phase3:t06 && pnpm run test:phase3:t07 && pnpm run test:phase3:t08 && pnpm run test:phase3:t09 && pnpm run test:phase3:t10",
    "test:phase4": "vitest run --config ./vitest.phase4.config.mts",
    "test:phase5": "vitest run --config ./vitest.phase5.config.mts",
    "verify:phase2": "tsx scripts/phase2/acceptance.ts --check",
    "preflight:phase2": "tsx scripts/phase2/preflight.ts",
    "phase1:acceptance": "tsx scripts/phase1/acceptance.ts",
    "test:phase1": "pnpm run test:phase1:contracts && pnpm run test:phase1:migrations && pnpm run test:phase1:storage && pnpm run test:phase1:source && pnpm run test:phase1:observability && pnpm run test:phase1:access && pnpm run test:phase1:access:payload && pnpm run test:phase1:integration && pnpm run test:phase1:queues && pnpm run test:phase1:localization && pnpm run test:phase1:acceptance",
    "phase1:secret-scan": "tsx scripts/phase1/secret-scan.ts --cwd . .gba resources",
    "verify:phase1": "pnpm run test:phase1 && pnpm exec tsx scripts/phase1/acceptance.ts --check && pnpm run phase1:secret-scan && pnpm exec tsc --noEmit && pnpm run lint && git diff --check",
    "phase1:seed": "tsx scripts/phase1/seed.ts",
    "phase1:migrate": "tsx scripts/phase1/apply-migration.ts",
    "phase1:backup": "tsx scripts/phase1/backup.ts",
    "phase1:restore": "tsx scripts/phase1/restore.ts",
    "test:phase1:migrations": "tsx scripts/phase1/migration-roundtrip.ts",
    "test:int": "cross-env NODE_OPTIONS=--no-deprecation tsx scripts/run-with-postgres.ts node_modules/vitest/vitest.mjs run --config ./vitest.config.mts"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "1.20.1",
    "@payloadcms/db-d1-sqlite": "3.88.0",
    "@payloadcms/db-postgres": "3.88.0",
    "@payloadcms/next": "3.88.0",
    "@payloadcms/richtext-lexical": "3.88.0",
    "@payloadcms/storage-r2": "3.88.0",
    "@payloadcms/ui": "3.88.0",
    "cross-env": "^7.0.3",
    "dotenv": "16.4.7",
    "drizzle-orm": "0.45.2",
    "graphql": "^16.8.1",
    "monaco-editor": "0.56.0",
    "next": "16.3.0",
    "payload": "3.88.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/eslintrc": "^3.2.0",
    "@fontsource-variable/outfit": "5.3.0",
    "@playwright/test": "1.58.2",
    "@testing-library/react": "16.3.0",
    "@types/node": "22.19.9",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "4.5.2",
    "embedded-postgres": "18.4.0-beta.17",
    "eslint": "^9.16.0",
    "eslint-config-next": "16.3.0",
    "jsdom": "28.0.0",
    "prettier": "^3.4.2",
    "tsx": "4.22.4",
    "typescript": "5.7.3",
    "vite-tsconfig-paths": "6.0.5",
    "vitest": "4.0.18",
    "wrangler": "~4.116.0"
  },
  "engines": {
    "node": "24.19.0",
    "pnpm": "11.19.0"
  },
  "packageManager": "pnpm@11.19.0",
  "cloudflare": {
    "bindings": {
      "PAYLOAD_SECRET": {
        "description": "Generate a random string using `openssl rand -hex 32`"
      }
    }
  }
}
